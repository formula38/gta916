# GTA916 server.cfg template
# Copy to your txAdmin profile config and fill with local secrets.

## Core identity
sv_hostname "GTA916 | Private Foundation"
sets sv_projectName "GTA916"
sets sv_projectDesc "Private homelab foundation build"
sv_maxclients 16

## Network
## (Enhanced note: endpoint_add_tcp/udp accept only ONE endpoint each now.)
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

## Private mode: do not announce to the public server list.
## Remove this line in Phase 2 when going public (requires port forwarding).
sv_master1 ""

## FiveM key (set locally, do not commit real key)
sv_licenseKey "REPLACE_WITH_LOCAL_LICENSE_KEY"

## Load local secret overrides if present (gitignored)
exec server.cfg.local

## Optional: Tebex (Phase 2 only)
# sv_tebexSecret "REPLACE_WITH_LOCAL_TEBEX_SECRET"

## Database example (if recipe requires it)
# set mysql_connection_string "mysql://user:pass@127.0.0.1/gta916?charset=utf8mb4"

## Basic permission example
add_ace group.admin command allow
add_principal identifier.fivem:YOUR_FIVEM_ID group.admin

## Resource start order (defaults come from cfx-server-data - see wire-profile.sh)
ensure mapmanager
ensure chat
ensure spawnmanager
ensure sessionmanager
## Start the freeroam map at boot. On Enhanced early access, maps started
## dynamically by mapmanager can fail cache generation ("Failed to generate
## cache for set: resource.rpf") - starting at boot avoids that and pins
## the map deterministically.
ensure fivem-map-hipster
ensure basic-gamemode
ensure baseevents
ensure hardcap
ensure rconlog

## GTAV Enhanced (early access) notes - these lines are harmless on legacy:
## - Pure mode is always ON in Enhanced - graphics mods are blocked in early access.
## - Enhanced supports only the latest gamebuild and loads it by default.
## - Uncomment to enable client dev tools on Enhanced (caps server at 8 slots):
# sv_devMode true

## Framework (managed by recipe - keep aligned with deployed resources)
# ensure qb-core

## GTA916 custom resources
ensure gta916-core
